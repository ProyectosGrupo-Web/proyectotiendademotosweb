@model webmotos.Models.Tipo
@{
    Layout = "~/Views/Shared/_Dashboard.cshtml";
}

<div class="container-fluid px-4">
    <h1 class="mt-4">Editar Ruta</h1>

    <div class="card mb-4">
        <div class="card-body">
            <h5>Editar Ruta</h5>
            @using (Html.BeginForm("EditTipo", "Admin", FormMethod.Post))
            {
                <!-- Campo oculto para el ID del SubEvento -->

                <input type="hidden" name="IdTipo" value="@Model.IdTipo" />

                <div class="mb-3">
                    @Html.LabelFor(m => m.Tipo1, new { @class = "form-label" })
                    @Html.TextBoxFor(m => m.Tipo1, new { @class = "form-control", required = "required" })
                </div>
                <div class="text-end">
                    <button type="submit" class="btn btn-success">Actualizar</button>
                </div>
            }
        </div>
    </div>
</div>
