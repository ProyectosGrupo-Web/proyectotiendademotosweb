@model IEnumerable<webmotos.Models.Moto>
@{
    Layout = "~/Views/Shared/_Dashboard.cshtml";
}
<div class="container-fluid px-4">
    <h1 class="mt-4">Modelos</h1>

    <div class="card mb-4">
        <div class="card-body">
            @using (Html.BeginForm("registrarModelos", "Admin", FormMethod.Post))
            {

                // Estructura de un textBox
                @* @Html.TextBox("name", "valor", new { atributos })*@

                <div class="form-floating mb-3">
                    @Html.TextBox("NombreModelo", null, new { @class = "form-control", placeholder = "Nombre del modelo" })
                    @Html.Label("NombreModelo", "Nombre del modelo")
                </div>
                <div class="mb-3">
                    <select class="form-select" id="Anio" name="Anio">
                        <option value="">Selecciona un año</option>
                        @for (int i = DateTime.Now.Year; i >= 2000; i--)
                        {
                            <option value="@i">@i</option>
                        }
                    </select>
                </div>
               
                <div class="d-flex justify-content-end">
                    <button type="submit" class="btn btn-success" id="btnRegistrar">Registrar</button>
                </div>
            }
        </div>
    </div>


    <!-- Tabla de eventos existentes -->
    <div class="card mb-4">
    <div class="card-body">
        <h5>Modelos registrados</h5>
        <table class="table table-striped table-bordered">
            <thead class="table-dark">
                <tr>
                    <th scope="col">Modelo</th>
                    <th scope="col">Precio</th>
                    <th scope="col">Color</th>
                    <th scope="col">Cilindrada</th>
                    <th scope="col">Potencia</th>
                    <th scope="col">Descripción</th>
                    <th scope="col">Velocidad</th>
                    <th scope="col">Fecha</th>
                    <th scope="col" class="text-center">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.IdModeloNavigation.NombreModelo</td>
                        <td>@item.Precio</td>
                        <td>@item.Color</td>
                        <td>@item.Cilindrada</td>
                        <td>@item.Potencia</td>
                        <td>@item.Descripcion</td>
                        <td>@item.velocidadMax</td>
                        <td>@item.CreadoEn.ToString("dd/MM/yyyy")</td>
                        <td class="text-center">
                            <!-- Botón Editar -->
                            <a href="@Url.Action("EditModelos", "Admin", new { id = item.IdModelo })" class="btn btn-primary btn-sm">Editar</a>
                            
                            <!-- Botón Eliminar con Modal -->
                            <button type="button" class="btn btn-danger btn-sm delete-btn" data-bs-toggle="modal" data-bs-target="#confirmDeleteModal" data-id="@item.IdModelo" title="Eliminar este modelo">
                                Eliminar
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

    <!-- Modal de Confirmación -->
    <div class="modal fade" id="confirmDeleteModal" tabindex="-1" aria-labelledby="confirmDeleteLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Confirmar Eliminación</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    ¿Estás seguro de eliminar el registro?
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <a href="#" id="deleteConfirmBtn" class="btn btn-danger">Eliminar</a>
                </div>
            </div>
        </div>
    </div>


    @* script para eliminar *@
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var confirmDeleteModal = document.getElementById("confirmDeleteModal");
            var deleteConfirmBtn = document.getElementById("deleteConfirmBtn");

            confirmDeleteModal.addEventListener("show.bs.modal", function (event) {
                var button = event.relatedTarget; // Botón que activó el modal
                var id = button.getAttribute("data-id"); // Obtener el ID

                // console.log("ID capturado:", id); // Verifica en consola si se captura bien

                if (id) {
                    deleteConfirmBtn.href = "/Admin/EliminarMotos/" + id;
                } else {
                    console.error("❌ Error: No se obtuvo un ID válido.");
                }
            });
        });
    </script>

    @* SCRIPT para DESACTIVAR REGISTRO luego del PRIMER CLICK *@
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const form = document.querySelector("form");
            const btn = document.getElementById("btnRegistrar");

            form.addEventListener("submit", function () {
                btn.disabled = true;
                btn.innerText = "Registrando..."; // Opcional: cambiar texto del botón
            });
        });
    </script>
</div>