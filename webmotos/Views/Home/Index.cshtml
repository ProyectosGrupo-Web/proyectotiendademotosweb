@model IEnumerable<webmotos.Models.Home>
@{
    ViewData["Title"] = "Home Page";
}




<div>
    <h2>CONTENIDO DEL HOME</h2>

    <table class="table">
        <thead>
            <tr>
                <th>idContenido</th>
                <th>Nombre</th>
                <th>url imagen</th>
                <th>descripcion</th>
                <th>prioridad</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var home in Model)
            {
                <tr>
                    <td>@home.IdContenido</td>
                    <td>@home.Nombre</td>
                    <td>@home.UrlImagen</td>
                    <td>@home.Descripcion</td>
                    <td>@home.Prioridad</td>
                </tr>
            }
        </tbody>
    </table>
</div>
