@model IEnumerable<webmotos.Models.Tipo>
@{
    Layout = "~/Views/Shared/_Dashboard.cshtml";
}


<div class="container-fluid px-4">
    <h1 class="mt-4">Tipos de motos</h1>

    <div class="card mb-4">
        <div class="card-body">
            @using (Html.BeginForm("registrarTipos", "Admin", FormMethod.Post))
            {

                @* <div class="mb-3">
                    @Html.Label("Tipo", "Tipo", new { @class = "form-label" })
                    <input type="text" name="Tipo1" class="form-control" required />
                </div> *@

                @* @Html.TextBox("name", "valor", new { atributos })*@

                <div class="form-floating mb-3">
                    @Html.TextBox("Tipo1", null, new { @class = "form-control", placeholder = "Tipo", required = "required" })
                    @Html.Label("Tipo1", "Tipo")
                </div>



                

                <div class="d-flex justify-content-end">
                    <button type="submit" class="btn btn-success">Registrar</button>
                </div>
            }
        </div>
    </div>


    <!-- Tabla de eventos existentes -->
    <div class="card mb-4">
        <div class="card-body">
            <h5>Tipos en registro</h5>
            <table class="table table-striped table-bordered">
                <colgroup>
                    <col style="width: 70%;"> <!-- Ancho de la columna "Nombre" -->
                    <col style="width: 30%;"> <!-- Ancho de la columna "Acciones" -->
                </colgroup>
                <thead class="table-dark">
                    <tr>
                        
                        <th>Nombre</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            
                            <td>@Html.DisplayFor(m => item.Tipo1)</td>
                            <td class="text-center">
                                <!-- Enlace para Editar -->
                                @Html.ActionLink("Editar", "EditTipo", "Admin", new { id = item.IdTipo }, new { @class = "btn btn-primary btn-sm" })
                                @* @Html.ActionLink("Eliminar", "EliminarTipo", "Admin", new { id = item.IdTipo}, new { @class = "btn btn-danger btn-sm", onclick = "return confirm('¿Estás seguro que quieres eliminar?');" }) *@
                                <a href="#" class="btn btn-danger btn-sm" data-bs-toggle="modal" data-bs-target="#confirmDeleteModal" data-id="@item.IdTipo">Eliminar</a>

                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Modal de Confirmación -->
    <div class="modal fade" id="confirmDeleteModal" tabindex="-1" aria-labelledby="confirmDeleteLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Confirmar Eliminación</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    ¿Estás seguro de que quieres eliminar este tipo?
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <a href="#" id="deleteConfirmBtn" class="btn btn-danger">Eliminar</a>
                </div>
            </div>
        </div>
    </div>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var confirmDeleteModal = document.getElementById("confirmDeleteModal");
            var deleteConfirmBtn = document.getElementById("deleteConfirmBtn");

            confirmDeleteModal.addEventListener("show.bs.modal", function (event) {
                var button = event.relatedTarget; // Botón que activó el modal
                var id = button.getAttribute("data-id"); // Obtener el ID

                // console.log("ID capturado:", id); // 👀 Verifica en consola si se captura bien

                if (id) {
                    deleteConfirmBtn.href = "/Admin/EliminarTipo/" + id;
                } else {
                    console.error("❌ Error: No se obtuvo un ID válido.");
                }
            });
        });
    </script>
</div>

